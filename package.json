{
  "name": "cold-open",
  "private": true,
  "version": "0.0.0",
  "description": "A professional script-writing web app with automatic formatting.",
  "license": "MIT",
  "repository": "github:kfraker/cold-open",
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "(svelte-kit sync || echo '') && (lefthook install || echo 'lefthook: hooks not installed, no git repo')",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test:unit": "vitest",
    "test:coverage": "vitest --run --coverage",
    "test:e2e": "playwright test",
    "flows:report": "node scripts/flow-report.ts",
    "flows:update": "node scripts/flow-report.ts --update",
    "licenses": "node scripts/check-licenses.ts",
    "test": "npm run test:coverage && npm run test:e2e && npm run flows:report"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@sveltejs/adapter-auto": "8.0.0",
    "@sveltejs/adapter-vercel": "7.0.1",
    "@sveltejs/kit": "3.1.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "24.19.2",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.13.0",
    "lefthook": "2.2.2",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "vitest-browser-svelte": "3.1.0"
  }
}
